{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Local: Debug launcher app",
      "type": "debugpy",
      "request": "launch",
      "module": "apps.launcher.main",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Prod: Debug launcher app)",
      "type": "debugpy",
      "request": "launch",
      "module": "apps.launcher.main",
      "console": "integratedTerminal",
      "justMyCode": false,
      "env": {
        "APP_ENV": "production"
      }
    }
  ]
}
